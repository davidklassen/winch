set mailserver localhost using hostname "{{ .host.name }}"
set mail-format { from: Monit {{ title .host.short }} <monit@{{ .host.name }}> }
{{ range .vars.alert_addresses -}}
set alert {{ . }}
{{ end -}}
set httpd unixsocket /run/monit.sock
  allow monit:{{ .vars.monit_password }}
set ssl { verify: enable }
