<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{{ vars.domain }}</title>
  </head>
  <body>
    <h1>{{ vars.domain }}</h1>
    <ul>
{{- for page in vars.website_pages }}
      <li><a href="/{{ page }}">{{ upper(page[:1]) + page[1:] }}</a></li>
{{- end }}
    </ul>
{{- if len(vars.website_peers) > 0 }}
    <p>Also served by:{{ for peer in vars.website_peers }} {{ peer.name }}{{ end }}</p>
{{- end }}
  </body>
</html>
