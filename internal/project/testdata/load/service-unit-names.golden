pipelines/site.yaml:5:25: name: "nginx@" needs an instance name after "@"
pipelines/site.yaml:6:25: name: "@foo" needs a name before "@"
pipelines/site.yaml:7:25: name: "getty@.service" needs an instance name after "@"
