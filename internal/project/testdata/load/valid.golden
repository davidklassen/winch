project acme, inventory inventories/test.yaml
host web1 address=192.0.2.1 user=admin
host web2 address=web2 user=deploy
pipeline site
stage base hosts=all targets=web1,web2
  file {"path":"/etc/motd","content":"hi"} at pipelines/site.yaml:5:9
stage one hosts=web2 targets=web2
  file {"path":"/etc/issue","absent":true} at pipelines/site.yaml:11:9
