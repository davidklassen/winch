stage web
  recipe nginx at pipelines/site.yaml:5:9
    pkg {"name":["nginx"]} at recipes/nginx/recipe.yaml:2:5
    file {"path":"/etc/nginx/nginx.conf","validate":"nginx -t"} data="events {}\n" at recipes/nginx/recipe.yaml:4:5
      notify nginx.reload
      notify nginx.restart
    handler nginx.restart at recipes/nginx/recipe.yaml:10:3
      service {"name":"nginx","restarted":true} at recipes/nginx/recipe.yaml:11:7
    handler nginx.reload at recipes/nginx/recipe.yaml:15:3
      service {"name":"nginx","reloaded":true} name="Reload" at recipes/nginx/recipe.yaml:16:7
  recipe site at pipelines/site.yaml:6:9
    file null at recipes/site/recipe.yaml:4:5
      notify nginx.reload
    link null at recipes/site/recipe.yaml:10:5
      notify nginx.reload
  file {"path":"/etc/motd"} data="hi" at pipelines/site.yaml:7:9
    notify nginx.reload
stage db
  recipe db at pipelines/site.yaml:14:9
    file {"path":"/etc/db.conf"} data="hi" at recipes/db/recipe.yaml:2:5
stage all
  file {"path":"/etc/issue"} data="hi" at pipelines/site.yaml:18:9
    notify nginx.reload
