host mail.acme.com user=root groups=all,mail vars={"admins":["root","david"],"domain":"acme.com","mail_server":true,"web_port":8080,"web_sites":["a","b"]}
host monitor.acme.com user=admin groups=all vars={"admins":["root","david"],"domain":"acme.com","mail_server":true}
stage web targets=mail.acme.com,monitor.acme.com
stage mail targets=mail.acme.com
