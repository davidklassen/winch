web1
  base
    ? Clean: cmd
        true
        rm -rf /srv/x
    * assert
        test -d /srv
        test -d /etc
    + file /etc/nginx/nginx.conf
        owner root, group root, mode 0644
        @@ -0,0 +1,1 @@
        +events {}
        validate: nginx -t
    + file /etc/motd
        owner root, group root, mode 0644
        @@ -0,0 +1,1 @@
        +hello
        validate:
          grep -q hello /etc/motd
          test -s /etc/motd
    ~ file /etc/app.conf
        mode 0600 → 0644
    ~ certbot example.com
        deploy_hook
            systemctl reload nginx
            systemctl reload dovecot
        pre_hook true ... →
            systemctl stop nginx
            sleep 1

